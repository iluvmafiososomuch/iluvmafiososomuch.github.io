    <!-- Scripts for UI Interactions -->
    <script>
        // Reading Progress Bar Indicator
        window.addEventListener('scroll', () => {
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            document.getElementById('progress-bar').style.width = scrolled + '%';
        });

        // Dark Mode Toggle Logic
        function toggleDarkMode() {
            const html = document.documentElement;
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        // Font Size Adjuster Logic
        function setFontSize(size) {
            const content = document.getElementById('reading-content');
            content.classList.remove('reading-font-sm', 'reading-font-md', 'reading-font-lg');
            
            // Reset button active styles
            document.getElementById('font-sm').className = "px-2.5 py-1 rounded hover:bg-white dark:hover:bg-slate-700 transition";
            document.getElementById('font-md').className = "px-2.5 py-1 rounded hover:bg-white dark:hover:bg-slate-700 transition";
            document.getElementById('font-lg').className = "px-2.5 py-1 rounded hover:bg-white dark:hover:bg-slate-700 transition";

            if (size === 'sm') {
                content.classList.add('reading-font-sm');
                document.getElementById('font-sm').className = "px-2.5 py-1 rounded bg-white dark:bg-slate-700 shadow-sm text-amber-600 dark:text-amber-400 font-bold transition";
            } else if (size === 'md') {
                content.classList.add('reading-font-md');
                document.getElementById('font-md').className = "px-2.5 py-1 rounded bg-white dark:bg-slate-700 shadow-sm text-amber-600 dark:text-amber-400 font-bold transition";
            } else if (size === 'lg') {
                content.classList.add('reading-font-lg');
                document.getElementById('font-lg').className = "px-2.5 py-1 rounded bg-white dark:bg-slate-700 shadow-sm text-amber-600 dark:text-amber-400 font-bold transition";
            }
        }

        // Citation Smooth Scroll & Highlight
        function scrollToCitation(id) {
            const element = document.getElementById(id);
            if (element) {
                element.scrollIntoView({ behavior: 'smooth', block: 'center' });
                element.classList.add('citation-highlight');
                setTimeout(() => {
                    element.classList.remove('citation-highlight');
                }, 2500);
            }
        }

        // Initial Theme Detection
        (function initTheme() {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
